# Copy to .env to override defaults. Development-only values; never reuse in deployment.
POSTGRES_PASSWORD=fkg_dev_only
FRONTEND_PORT=8080
# Test mode: adjustable clock + demo reset endpoints. Local demo/tests only.
FKG_TEST_MODE=1
# Token signing secret; leave empty for a random per-start key.
REGISTRY_TOKEN_SECRET=
# Test-only payload capture inside agents (leak scan). Set 0 outside local tests.
FKG_CAPTURE_PAYLOADS=1
# Development-only plaintext matcher (discloses identifiers!). Keep 0.
DEV_PLAINTEXT_MATCHER=0
